[flake8]
max-line-length = 100
exclude =
    .git,
    __pycache__,
    build,
    dist,
    *.egg-info,
    venv,
    .venv,
    migrations
extend-ignore = E203, W503
max-complexity = 10
show-source = True
statistics = True
count = True
